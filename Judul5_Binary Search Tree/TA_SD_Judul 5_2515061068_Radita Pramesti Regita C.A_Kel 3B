class Node:
    def __init__(self, key):
        self.key = key       
        self.left = None     
        self.right = None   

class KamusBST:
    def __init__(self):
        self.root = None

    def insert_node(self, root, key):
        if root is None:
            return Node(key.lower()) # Simpan dalam huruf kecil agar seragam
        
        # Perbandingan string berdasarkan urutan kamus (leksikografis)
        if key.lower() < root.key:
            root.left = self.insert_node(root.left, key)
        elif key.lower() > root.key:
            root.right = self.insert_node(root.right, key)
        return root

    def insert(self, key):
        self.root = self.insert_node(self.root, key)

        if root is None:
            return False
        if root.key == key.lower():
            return True
        if key.lower() < root.key:
            return self.search_node(root.left, key)
        return self.search_node(root.right, key)

    def check_spelling(self, key):
        return self.search_node(self.root, key)

    def find_suggestions(self, root, prefix, results):
        if root is None:
            return
        
        if root.key.startswith(prefix.lower()):
            results.append(root.key)

        if prefix.lower() <= root.key:
            self.find_suggestions(root.left, prefix, results)

        if prefix.lower() >= root.key or root.key.startswith(prefix.lower()):
            self.find_suggestions(root.right, prefix, results)

    def get_auto_complete(self, prefix):
        results = []
        self.find_suggestions(self.root, prefix, results)
        return sorted(results) 

def main():
    kamus = KamusBST()
    kata_awal = ["buku", "baca", "budi", "belajar", "bola", "bintang", "coding", "computer", "data", "struktur"]
    for kata in kata_awal:
        kamus.insert(kata)
        
    pilih = 0
    while pilih != 4:
        print("\n=== FITUR KAMUS BST (AUTO-COMPLETE & SPELL CHECK) ===")
        print("1. Tambah Kata Baru ke Kamus")
        print("2. Cek Ejaan Kata (Spell Check)")
        print("3. Ketik Kata (Auto-Complete)")
        print("4. Keluar")
        
        try:
            pilih = int(input("Pilih: "))
        except ValueError:
            print("Input tidak valid!")
            continue
            
        if pilih == 1:
            kata = input("Masukkan kata baru: ").strip()
            if kata:
                kamus.insert(kata)
                print(f"Kata '{kata}' berhasil disimpan di Kamus.")
            else:
                print("Kata tidak boleh kosong!")
                
        elif pilih == 2:
            kata = input("Masukkan kata yang ingin dicek ejaannya: ").strip()
            if kamus.check_spelling(kata):
                print(f"Hasil: Ejaan kata '{kata}' BENAR (Tersedia di kamus).")
            else:
                print(f"Hasil: Ejaan kata '{kata}' SALAH/TIDAK DIKENAL.")
                # Memberikan saran kata terdekat jika salah ketik
                saran = kamus.get_auto_complete(kata[:2]) if len(kata) >= 2 else []
                if saran:
                    print(f"Maksud Anda mungkin: {', '.join(saran)}?")
                    
        elif pilih == 3:
            prefix = input("Ketik awalan kata (prefiks): ").strip()
            if prefix:
                saran_kata = kamus.get_auto_complete(prefix)
                if saran_kata:
                    print(f"Rekomendasi kata untuk '{prefix}':")
                    for s in saran_kata:
                        print(f" - {s}")
                else:
                    print(f"Tidak ada rekomendasi kata yang berawalan '{prefix}'.")
            else:
                print("Prefiks tidak boleh kosong!")
                
        elif pilih == 4:
            print("Program selesai.")
        else:
            print("Pilihan tidak valid!")

if __name__ == "__main__":
    main()
