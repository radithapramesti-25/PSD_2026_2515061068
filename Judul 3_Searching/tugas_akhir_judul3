def tampilkan_parkiran(daftar_slot):
    print("\nStatus Parkir Saat Ini:")
    for i in range(len(daftar_slot)):
        print(f"Slot {i+1}: [{daftar_slot[i]}]", end="  ")
    print("\n")

def proses_parkir(daftar_slot, pilihan_user):
    indeks_target = pilihan_user - 1 
    if indeks_target < 0 or indeks_target >= len(daftar_slot):
        print("Error: Nomor slot tidak tersedia!")
        return False
    elif daftar_slot[indeks_target] == "KOSONG":
        daftar_slot[indeks_target] = "TERISI" 
        print(f"Sukses! Anda telah parkir di Slot {pilihan_user}.")
        return True
    else:
        print(f"Maaf, Slot {pilihan_user} sudah terisi. Silakan cari slot lain.")
        return False

def main():
    parkiran_mall = ["ISI", "KOSONG", "ISI", "ISI", "KOSONG", "KOSONG", "KOSONG", "ISI"]
    print("=== SISTEM RESERVASI PARKIR MALL ===")
    
    while True:
        tampilkan_parkiran(parkiran_mall)
        try:
            pilihan = int(input("Pilih nomor slot untuk parkir (atau 0 untuk keluar): "))
            if pilihan == 0:
                print("Terima kasih telah menggunakan layanan kami.")
                break
            proses_parkir(parkiran_mall, pilihan)
        except ValueError:
            print("Input tidak valid! Harap masukkan angka.")

if __name__ == "__main__":
    main()
